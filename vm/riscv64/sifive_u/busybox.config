# =============================================================================
# 此配置只启用 initramfs 启动和交互 shell 所需的最小 BusyBox 功能
#
# - 基线：构建脚本先执行 `make allnoconfig`
# - CONFIG_STATIC：使 BusyBox 静态链接，因此 initramfs 不需要携带 dynamic
#   linker 或 shared libraries
# - 相比完整 `defconfig`：省略网络、归档与文本处理、用户管理、服务守护进程
#   及大多数存储工具
# =============================================================================

CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y

# 交互 shell，以及 /init 和系统检查所需的 applet
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_CTTYHACK=y
CONFIG_SETSID=y

CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_HOSTNAME=y
CONFIG_UNAME=y
CONFIG_GREP=y
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_PWD=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_DMESG=y
CONFIG_PS=y
CONFIG_FREE=y
CONFIG_NPROC=y
CONFIG_SLEEP=y
CONFIG_SYNC=y
CONFIG_REBOOT=y
CONFIG_POWEROFF=y
