# =============================================================================
# QEMU SiFive HiFive Unleashed machine 使用的最小 RISC-V 内核配置
#
# - 基线：build-linux.sh 在 `make allnoconfig` 后应用本配置片段
# - 启动方式：QEMU direct boot，加载 gzip 压缩的 newc initramfs
# - 设备范围：只保留 sifive_u 启动所需的 SBI、PLIC、PRCI clock 和 SiFive UART
# =============================================================================

CONFIG_LOCALVERSION="-sifive-u"
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_MODULES=n
CONFIG_ACPI=n
CONFIG_EFI=n
CONFIG_PCI=n
CONFIG_COMPAT=n

# 关闭 KASLR，使 kernel Image 的 virtual address 保持固定，便于调试
CONFIG_RANDOMIZE_BASE=n

# 交叉 toolchain 生成的静态 userspace 会使用 F/D 浮点寄存器
# CONFIG_FPU 负责在进入 userspace 时启用并保存这些寄存器
CONFIG_FPU=y

# QEMU direct boot 及其提供的 gzip 压缩 newc initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# QEMU sifive_u DTB 描述以下启动和控制台所需的硬件接口
#
# - SBI：Supervisor Binary Interface，kernel 通过它请求 firmware 提供 timer、IPI 和 reset
# - PLIC：Platform-Level Interrupt Controller，将 UART 等外部中断分发给 CPU
# - RISC-V timer：由 SBI 提供 scheduler 和时间维护所需的时钟中断
# - PRCI：Power Reset Clock Interrupt，为 FU540 peripherals 提供 clock
# - SiFive UART：HiFive Unleashed 的 UART，console device 为 ttySIF0
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_SIFIVE_PLIC=y
CONFIG_SOC_SIFIVE=y
CONFIG_CLK_SIFIVE=y
CONFIG_CLK_SIFIVE_PRCI=y
CONFIG_SERIAL_SIFIVE=y
CONFIG_SERIAL_SIFIVE_CONSOLE=y

# init 脚本在启动 BusyBox shell 前挂载的文件系统
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y

# 保留必要诊断能力，同时排除无关的网络和调试代码
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_VT=n
CONFIG_NET=n
CONFIG_DEBUG_KERNEL=n
