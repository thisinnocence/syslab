# =============================================================================
# 自定义 QEMU mini-virt machine 使用的最小 arm64 内核配置
#
# - 基线：build-linux.sh 在 `make allnoconfig` 后应用本配置片段
# - 启动方式：QEMU direct boot，加载 gzip 压缩的 newc initramfs
# - 设备范围：只保留 mini-virt DTS 描述的 GICv3、architectural timer 和 PL011
# =============================================================================

CONFIG_LOCALVERSION="-mini-virt"
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_ARCH_DEMO=y
CONFIG_MODULES=n
CONFIG_ACPI=n
CONFIG_EFI=n
CONFIG_PCI=n
CONFIG_COMPAT=n

# 关闭 KASLR，使 kernel Image 的 virtual address 保持固定，便于调试
CONFIG_RANDOMIZE_BASE=n

# QEMU direct boot 及其提供的 gzip 压缩 newc initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# mini-virt DTS 只描述以下启动和控制台所需的硬件接口
#
# - GICv3：ARM 中断控制器，将 timer 和 UART 等设备的中断分发给 CPU
#   CONFIG_ARM_GIC_V3 提供对应驱动
# - architectural timer：ARM 架构标准定时器，为内核调度和时间维护提供时钟中断
# - PL011：串口，CONFIG_SERIAL_AMBA_PL011 及 CONFIG_SERIAL_AMBA_PL011_CONSOLE 提供对应驱动
# - PSCI：firmware call interface，用于启动 SMP 的第二个 CPU 及执行电源管理操作
#   CONFIG_ARM_PSCI_FW 启用该接口
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_PSCI_FW=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SYSLAB_SEC=y

# init 脚本在启动 BusyBox shell 前挂载的文件系统
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y

# 保留必要诊断能力，同时排除无关的网络和调试代码
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_VT=n
CONFIG_NET=n
CONFIG_DEBUG_KERNEL=n
